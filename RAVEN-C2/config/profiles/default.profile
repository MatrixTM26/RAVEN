profile.name=default
profile.description=Default RAVEN operator profile
profile.created_at=2026-08-04 00:00:00

operator.theme=dark
operator.prompt.color=red
operator.output.box=true
operator.output.timestamp=true
operator.session.log.limit=100
operator.history.limit=50
operator.auto.reconnect=true
operator.chat.notify=true
operator.timezone=UTC
operator.date.format=yyyy-MM-dd HH:mm:ss
operator.interactive.exit=back
operator.broadcast.confirm=true
operator.selfdestruct.confirm=true
