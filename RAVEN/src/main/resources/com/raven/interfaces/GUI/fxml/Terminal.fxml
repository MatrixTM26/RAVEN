<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fillWidth="true" spacing="0" styleClass="root" stylesheets="@../styles/raven.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25.0.1" fx:controller="com.raven.interfaces.GUI.module.UI.controller.TerminalController">

    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="toolbar-bar">
        <Label styleClass="stat-label" text="SESSION" />
        <TextField fx:id="SessionIdField" prefWidth="68" promptText="ID" styleClass="input-field" />
        <Region>
            <maxWidth>1</maxWidth>
            <minWidth>1</minWidth>
            <style>-fx-background-color:#1f1f1f;</style>
            <minHeight>14</minHeight>
        </Region>
        <Label fx:id="SelectedLabel" alignment="TOP_LEFT" styleClass="text-muted" text="No session selected" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#OnSysinfo" prefHeight="28.0" prefWidth="75.0" styleClass="btn,btn-primary" text="Sysinfo" textAlignment="JUSTIFY" />
        <Button onAction="#OnClear" prefHeight="28.0" prefWidth="72.0" styleClass="btn,btn-default" text="Clear" textAlignment="JUSTIFY" />
    </HBox>

    <TextArea fx:id="TermOutput" editable="false" prefHeight="338.0" prefWidth="664.0" styleClass="terminal-area" wrapText="true" VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER_LEFT" spacing="6" styleClass="input-bar">
        <Label fx:id="PromptLabel" prefHeight="18.0" prefWidth="16.0" styleClass="cmd-prompt" text="❯" />
        <TextField fx:id="CmdField" alignment="CENTER" onAction="#OnSend" prefHeight="28.0" prefWidth="550.0" promptText="Enter command..." styleClass="input-field" HBox.hgrow="ALWAYS" />
        <Button onAction="#OnSend" styleClass="btn,btn-primary" text="Send" textAlignment="JUSTIFY" />
    </HBox>
</VBox>
